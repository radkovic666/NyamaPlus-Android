# EXAMPLE ONLY. PHP does not load this file: inject values through the PHP-FPM/server environment.
NYAMA_SUBTITLE_PUBLIC_BASE=https://nyama.fun/api/subtitles
NYAMA_SUBTITLE_STORAGE=/var/lib/nyama-subtitles
NYAMA_SUBTITLE_AUTH_ADAPTER=/etc/nyama-subtitles/auth-adapter.php
NYAMA_SUBTITLE_SIGNING_SECRET=
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_BEARER_TOKEN=
OPENSUBTITLES_USER_AGENT=NyamaPlus v1.0.43
# Exact HTTPS hosts observed in your authorized /download responses. No wildcard or URL input.
OPENSUBTITLES_DOWNLOAD_HOSTS=
# Set conservatively within your actual plan. These are local caps, not promised API quotas.
NYAMA_SUBTITLE_DOWNLOADS_PER_USER=10
NYAMA_SUBTITLE_DOWNLOADS_GLOBAL=100
