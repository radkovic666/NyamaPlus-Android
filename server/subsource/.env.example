# Placeholders only. PHP-FPM/systemd must inject these; this file is NOT auto-loaded.
SUBSOURCE_API_KEY=
NYAMA_SUBTITLE_PUBLIC_BASE=https://nyama.fun/api/subtitles
NYAMA_SUBTITLE_SIGNING_SECRET=
NYAMA_SUBSOURCE_STORAGE=/var/lib/nyama-subsource
NYAMA_SUBTITLE_AUTH_ADAPTER=/etc/nyama-subtitles/auth-adapter.php
NYAMA_ACTIVATION_PRIVATE_LOADER=/etc/nyama-subtitles/activation-loader.php
# Enable only after confirming your plan permits temporary hosting for VidAPI fetches.
SUBSOURCE_TEMP_HOSTING_APPROVED=0
# Optional exact redirect hosts verified from provider documentation, no wildcard; key is never forwarded.
SUBSOURCE_DOWNLOAD_HOSTS=
# Optional existing mobile handler on same route; leave empty if it has not been deployed.
NYAMA_LEGACY_SUBTITLE_ROUTER=
